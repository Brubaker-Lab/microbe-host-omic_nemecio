# Train model on  data -------------------------------------------------
tunedSvmPars_gene<-tuneParams(learner= svm_gene,                   # to get best performing set of parameters
task= geneTask,
resampling = inner_cv,
par.set=svm_gene_ParamSpace,
control = randSearch_extended
)
print("Determined Hyperparameters for Model Training: " ) # list of determined hyperparameters
tunedSvmPars_gene$x
# generateHyperParsEffectData(tunedSvmPars_gene) should get table about hyperparamter tuning see reference
# Apply the hyperparameters
tunedSvm_gene<-setHyperPars(svm_gene,
par.vals = tunedSvmPars_gene$x)
# THE TRAINED MODEL
tunedSvmModel_gene<-mlr::train(tunedSvm_gene, geneTask) # KEYSTONE
# The Trained Model Performance Metrics
as.data.frame(tunedSvmPars_gene$opt.path)
# Hyperparameters
print( paste0("Determined Hyperparameters for Model Training: ") ) #
print(tunedSvmPars_gene$x)
# Model
print( paste0("Trained Model: " ) ) #
model_overview<-capture.output({tunedSvmModel_gene})
print(model_overview)
# Used and defined in the CV ------------------
# Define outer CV for Learning Curve
outer_cv_lc <- makeResampleDesc("CV", iters = 10,
stratify.cols = "TV_state", predict = "both")
# Learner
svm_learner_opthyper<-makeLearner("classif.svm",
predict.type="prob",
predict.threshold = desired_prob_thresh, # want performance metrics for the desired threshold
par.vals = tunedSvmPars_gene$x)   # OPTIMAL HYPERPARAMTERS for model training
# Performance metrics Aggregated
