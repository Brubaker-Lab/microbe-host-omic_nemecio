#v(df_mbiocomp_dat_pres_pop_trans)
input1_loop_pro<-df_hp3_pro_dat_select_tran
input2_loop_mbiocomp<-df_mbiocomp_dat_pres_pop_trans
#spearman corr
microbes_vs_genes_corr_loop<-cor(input2_loop_mbiocomp,
input1_loop_pro,
method = "spearman")
microbes_vs_genes_corr_loop<-as.data.frame(microbes_vs_genes_corr_loop)
#transpose and calc tv corr
# left over from original code we do not use this value for training or prediction
microbes_vs_genes_corr_loop_trans<-as.data.frame(base::t(microbes_vs_genes_corr_loop))
TV_microbe_gene_corr_loop<-cor(microbes_vs_genes_corr_loop_trans,                                                                         y = df_lincs_gene_tv_sharedgenes, method = "spearman")
TV_microbe_gene_corr_loop<-as.data.frame(TV_microbe_gene_corr_loop)
# formerly "Master_analysis"
Master_raw<-cbind(TV_microbe_gene_corr_loop, microbes_vs_genes_corr_loop)
Master_raw_copy<-Master_raw
# retain genes
col<-which(colnames(Master_raw)=="A2M")
Master_raw_gene<-Master_raw[,col:ncol(Master_raw)]
if( col == 2 & ncol(Master_raw) == 387 ){ # 387 PROTEINS DEPICTED
Master_raw_temp<-as.data.frame(Master_raw[,1])
colnames(Master_raw_temp)[1]<-"tenofovir"
} else { stop( "There be an issue with the col when making the Master_raw and which col is defined as A2M") }
# TV state
Master_raw_temp$Microbes<-rownames(Master_raw_gene)
Master_raw_temp$TV_state<-c(rep(NA, nrow(Master_raw_temp)))
Master_raw_temp$TV_Mic_iteration<-c(rep("raw-corr", nrow(Master_raw_temp)))
Master_raw_temp$MvG_iteration<-c(rep("raw-corr", nrow(Master_raw_temp)))
#generate microbe name column
Master_raw_temp<-Master_raw_temp%>%
dplyr::select(Microbes, TV_state, TV_Mic_iteration, tenofovir, MvG_iteration)
# rejoin
Master_raw<-cbind(Master_raw_temp,Master_raw_gene )
# clear the rownames
rownames(Master_raw)<- NULL
# Created dataset
d(Master_raw)
#v(Master_raw)
#objects needed
# Make matrix
df_lincs_gene_tv_sharedgenes<-as.matrix(df_lincs_gene_tv_sharedgenes)
# define columns with genes
gene_col_index_start <- which(colnames(Master_raw) == "A2M")
gene_col_index_end <- ncol(Master_raw)
# Select columns with genes and transpose
MA_raw_gene<-Master_raw[,gene_col_index_start:gene_col_index_end]
MA_raw_gene<-as.matrix(MA_raw_gene)
MA_raw_gene_trans<-base::t(MA_raw_gene)
#multiply the gene expression LINCS sig to the microbe-gene corr (microbe-Host)
MA_raw_gene_exp_multi_genesonly<-df_lincs_gene_tv_sharedgenes[,1] * MA_raw_gene_trans
#transpose back to normal orientation
MA_raw_gene_exp_multi_genesonly<-base::t(MA_raw_gene_exp_multi_genesonly)
# Create Dataframe with new gene exp x microbe-gene corr
MA_raw_gene_exp_multi_genesonly<-cbind(Master_raw[,1:gene_col_index_start-1], MA_raw_gene_exp_multi_genesonly)
# Created Df
d(MA_raw_gene_exp_multi_genesonly)
# Chose features ----------------------------------------------------
