gene_index_start<-which(colnames(MA_raw_gene_exp_multi_genesonly) == "A2M")
#desired col names in training data
alongforride_colnames<-colnames(MA_raw_gene_exp_multi_genesonly[1:gene_index_start-1])
colnames_w_features<- c(alongforride_colnames, boot_10_shared_feat)
# Keep only TV_state that is UNKNOWN + known
TV_prediction<-MA_raw_gene_exp_multi_genesonly%>%
# filter(is.na(TV_state)) %>% #keep known as "pos" control to see where they land
dplyr::select(dplyr::all_of(colnames_w_features))
TV_prediction$TV_state <- factor(TV_prediction$TV_state)
#Remove Col that are along for the ride
#Note: need to maintain data structure consistency with data that was sued for training, eventhough the TV_state column is empty. B/C of this we will add back th e microbe names after prediction
