# raw_shared_microbes<-intersect(u(pred_sum_mic_GENE$Microbes), u(pred_sum_mic_PRO$Microbes))
raw_shared_microbes<- c("Prevotella",               "Fusobacterium nucleatum",
"Gardnerella vaginalis"     ,"Mobiluncus mulieris"      ,
"Atopobium vaginae"         ,"Lactobacillus hamsteri"   ,
"Pseudomonas aeruginosa"    ,"Lactobacillus hominis"    ,
"Bifidobacterium"           ,"Lactobacillus gasseri"    ,
"Peptostreptococcus"        ,"undistinguishable"        ,
"Pseudomonas"               ,"Lactobacillus"            ,
"Pseudomonas fulva"         ,"Lactobacillus gallinarum" ,
"Lactobacillus ultunensis"  ,"Lactobacillus vaginalis"  ,
"Lactobacillus iners"       ,"Pseudomonas syringae"     ,
"Lactobacillus crispatus"   ,"Lactobacillus helveticus" ,
"Lactobacillus jensenii"    ,"Lactobacillus taiwanensis")
# Data Prep ----------------------------------
#collect pos calls
pred_lab_round<-predictions_labeled%>%
mutate(prob.1=as.numeric(round(prob.1, 2)))%>%
mutate(response=as.numeric(as.character(response)))%>%
mutate(response = if_else(0.25 < prob.1 & prob.1< 0.75, 0 , response ))%>%
dplyr::select(Microbes, prob.1, response)%>%
filter(Microbes %in% raw_shared_microbes)%>%# select shared microbes
mutate(response=as.factor(response))
h(pred_lab_round)
# Plots Prep ----------------------------------
# pred_lab_round
# Define Values for Graphing ---------------------------------
pred_lab_round$response <- factor(pred_lab_round$response,
levels = c(-1, 0, 1),
labels = c("Nonmetabolize", "Indeterminate", "Metabolize"))
# Order Microbes in Specific sequence - Changed for PT since there are only one of each microbe therefore no pred_count file
level_order <- predictions_labeled$Microbe
# Specify colors
group_colors <- c( "Nonmetabolize" = "#1e88e5",  "Metabolize"= "#d81b60","Indeterminate" = "grey")
raw_pred_plot<-{
ggplot(pred_lab_round,
aes(x = factor(Microbes, level = level_order),
y = prob.1,
color = response)) +
theme_bw() +
ylim(-0.01, 1.01) +
geom_jitter(alpha = 0.5, width = 0.2, size = 2) +
geom_hline(yintercept=0.75, linetype="dashed", color = "darkgrey") +
geom_hline(yintercept=0.25, linetype="dashed", color = "darkgrey") +
scale_color_manual(values = group_colors,
breaks = c("Metabolize", "Indeterminate", "Nonmetabolize"),
name = "Predicted Classification",
) +
theme(#legend.position = c(0.2, 0.8),
plot.title = element_text(hjust =0.5, vjust = 4),
plot.subtitle = element_text(hjust = 0.5, vjust = 2),
axis.text.x = element_text(angle = 45, hjust = 1),
axis.title.x = element_text(vjust = -1),
axis.title.y = element_text(vjust = 5),
plot.margin = unit(c(1,1,1,1), "cm")) +
labs(title = "Prediction Probabilities ",
subtitle = paste0("TV-MHG")
) +
xlab("Microbes") +
ylab("Probability of Metabolizing")
}
raw_pred_plot
raw_pred_plot
